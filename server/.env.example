# ─── SignalDesk API ───
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# ─── Supabase (Project Settings → API) ───
# Use the public anon/publishable key only. Never put the service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─── Google Gemini (optional; mock mode is clearly labelled when absent) ───
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Resend (optional; draft-only email mode when absent) ───
RESEND_API_KEY=
RESEND_FROM_EMAIL=
